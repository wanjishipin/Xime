// =============================================
// 火山引擎流式语音识别插件元数据（宿主用宽松 JSON 解析，支持注释）
// =============================================

{
  // 插件唯一标识
  "id": "com.kingzcheung.xime.plugin.volc_asr",

  // 插件名称与描述（语音转文本服务商列表展示）
  "name": "火山引擎流式语音识别",
  "icon": "🎙️",
  "description": "火山方舟在线语音识别。使用火山引擎控制台获取的APP Key，可参考 快速入门（https://console.volcengine.com/speech/new/setting/apikeys?projectName=default）",

  // 插件版本（字符串）
  "version": "3.0.1",

  // 插件分类：speech 语音识别（单选激活）
  "type": "speech",
  "activation": "single",

  // 入口脚本（TS 源码由 xipm 编译为 IIFE 单文件）
  "entry": "main.js",

  // 目标平台（缺省视为 ["android"]；可选 android/ios/windows/macos/linux）
  "platforms": ["android"],

  // 宿主最低版本要求
  "minHostVersion": "3.0.0",

  // 能力声明
  "capabilities": {
    "speech": {
      "inputMode": "streaming",        // 实时流式识别
      "supportsPartialResults": true
    }
  },

  // 网络访问声明：插件需要连接的域名（宿主据此校验白名单/用户授权）
  "network": {
    "hosts": [
      "openspeech.bytedance.com"
    ]
  }
}
