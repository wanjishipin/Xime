// =============================================
// 颜文字表情包插件元数据（宿主用宽松 JSON 解析：支持 // 注释与尾逗号）
//
// 约定：
// - 插件包为 zip（.xipk），本文件置于包根目录
// - 逻辑用脚本实现（entry 指定 TS 编译产物 main.js），不包含任何可执行二进制
// - 资源放 resources/ 目录，脚本通过 host.resource.path() 获取路径
// =============================================
{
  // 插件唯一标识（反向域名风格，插件管理/激活/清理均依赖）
  "id": "com.kingzcheung.xime.plugin.kaomoji",

  // 插件名称与描述（插件中心展示）
  "name": "颜文字表情包",
  "description": "包含 174 个常用颜文字的表情插件",

  // 插件中心列表图标（字符图标，宿主渲染；也可留空用默认）
  "icon": "థ౪థ",

  // 插件版本（字符串）
  "version": "4.0.0",

  // 插件分类：emoji 表情（多选启用，即时生效）
  "type": "emoji",

  // 激活方式：single（单选，如语音识别）/ multi（多选，如表情）/ none（无）
  "activation": "multi",

  // 入口脚本（TS 编译产物，相对插件包根目录）
  "entry": "main.js",

  // 目标平台（缺省视为 ["android"]；可选 android/ios/windows/macos/linux）
  "platforms": ["android"],

  // 宿主最低版本要求（满足则加载，不满足插件中心提示不可用）
  "minHostVersion": "3.0.0",

  // 能力声明：宿主据此决定如何消费该插件
  "capabilities": {
    "emoji": {
      "supportsSearch": true, // 支持按文本搜索表情
      "columns": 3, // 表情网格列数（布局元数据，插件不再运行时声明）
      "itemHeightDp": 30
    }
  }
}
