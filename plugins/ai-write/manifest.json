// =============================================
// AI 帮写插件元数据（QuickJS/TS 版；宽松 JSON：支持 // 注释与尾逗号）
// =============================================
{
  // 插件唯一标识
  "id": "com.kingzcheung.xime.plugin.ai_write",

  // 插件名称与描述
  "name": "AI 帮写",
  "icon": "帮",
  "description": "输入草稿/指令，SSE 流式生成长文本，支持任意 OpenAI 兼容接口。",

  // 插件版本
  "version": "1.0.0",

  // 插件分类：tool 工具类（多开）
  "type": "tool",
  "activation": "multi",

  // 入口脚本（xime-plugin 编译产物）
  "entry": "main.js",

  // 目标平台（缺省视为 ["android"]；可选 android/ios/windows/macos/linux）
  "platforms": ["android"],

  // 宿主最低版本要求（工具栏按钮 + 工具面板契约 + SSE 流式原语）
  "minHostVersion": "3.0.0",

  // 工具栏入口
  "toolbarButtons": [
    {
      "id": "com.kingzcheung.xime.plugin.ai_write:open",
      "label": "AI 帮写",
      "action": "open_panel"
    }
  ],

  // 网络访问：接受用户自定义服务器地址
  "network": {
    "allowCustomHosts": true
  },

  // 能力声明
  "capabilities": {
    "tool": {
      "display": "direct"
    }
  }
}
